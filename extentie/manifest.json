{
  "manifest_version": 3,
  "name": "Social opvolglijst",
  "version": "1.0",
  "description": "Verzamel tekst, links en screenshots via rechtsklik en laat ze samenvatten.",
  "permissions": ["contextMenus", "storage", "downloads", "activeTab", "tabs", "scripting", "unlimitedStorage", "sidePanel", "history"],
  "host_permissions": ["https://api.anthropic.com/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["selectiepopup.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.youtube.com/watch*", "*://m.youtube.com/watch*"],
      "js": ["youtube-transcript.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Social opvolglijst"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "48": "icon.png"
  }
}
